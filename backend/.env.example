# Get your API key from https://build.nvidia.com
# Powers the LLM engine: nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Get your free key (2,500 free searches) from https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Optional: use lualatex for stronger Unicode support (defaults to lualatex when available)
# LATEX_COMPILER=lualatex
# Optional: absolute path to the selected LaTeX compiler if it is not on your PATH
# PDFLATEX_PATH=C:\path\to\miktex\bin\x64\pdflatex.exe
