# LLM config - set your model and API key for any provider
# Fast model (routing, structuring, analysis, ATS review):
#   nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b  (free tier available)
#   openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
#   openai/gpt-4o-mini
#   anthropic/claude-haiku-4-5-20251001
LLM_MODEL=nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b

# Stronger model used ONLY for resume / cover-letter generation (tailoring).
# Defaults to LLM_MODEL when unset. Examples:
#   nvidia_nim/meta/llama-3.3-70b-instruct
#   openrouter/meta-llama/llama-3.3-70b-instruct
#   openai/gpt-4o
# LLM_MODEL_GENERATION=nvidia_nim/meta/llama-3.3-70b-instruct

# Generic key used for every provider when the provider-specific key is unset.
LLM_API_KEY=your_api_key_here

# Provider-specific keys (preferred over LLM_API_KEY when both are set):
# OPENROUTER_API_KEY=your_openrouter_key_here
# NVIDIA_NIM_API_KEY=your_nvidia_key_here
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GROQ_API_KEY=your_groq_key_here

LLM_MAX_CONCURRENCY=4
# Optional model tuning and cost accounting (free tier defaults to zero cost)
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_INPUT_COST_PER_1M=0.0
LLM_OUTPUT_COST_PER_1M=0.0
RF_CLI_TIMELINE=false
RF_EVENT_BUFFER_CAPACITY=200

# Comma-separated browser origins allowed to call the API
# (Vite picks the next free port if :5173 is busy, so localhost + 127.0.0.1 on :5173/:5174)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Required in production for signed PDF access tokens
DOCUMENT_TOKEN_SECRET=replace_with_a_long_random_secret
# Optional safety limits
DOCUMENT_TOKEN_TTL_SECONDS=3600
LATEX_TIMEOUT_SECONDS=60
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Get your free key (2,500 free searches) from https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Optional: use lualatex for stronger Unicode support (defaults to lualatex when available)
# LATEX_COMPILER=lualatex
# Optional: absolute path to the selected LaTeX compiler if it is not on your PATH
# PDFLATEX_PATH=C:\path\to\miktex\bin\x64\pdflatex.exe
